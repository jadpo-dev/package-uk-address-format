        department_name: ""
        po_box: ""
        sub_building_name: "E"
        building_name: "Priory Court"
        building_number: ""
        dependant_thoroughfare: ""
        thoroughfare: "Kingshill Road"
        double_dependant_locality: ""
        dependant_locality: ""
        post_town: "DURSLEY"
        postcode: "AA1 1AC"
    }
    var expected: List<PafAddress> = [r1, r2, r3, r4, r5, r6, r7, r8, r9, r10]
    assert paf.sorted(list.reverse(expected)) == expected
    assert paf.sorted([r10, r1, r3, r2, r7, r4, r8, r9, r5, r6]) == expected
    assert paf.sorted([r5, r7, r6, r2, r8, r3, r1, r10, r4, r9]) == expected
    assert paf.sorted([r3, r6, r9, r7, r10, r1, r4, r5, r2, r8]) == expected
}

