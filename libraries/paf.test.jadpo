test "Rule 2 (4): Cath's Cakes" {
    // P01 1AF isn't a postcode in Great Britain's form, so the address
    // fails; its lines are checked without it.
    var as_given: PafAddress = PafAddress {
        organisation_name: "Cath's Cakes"
        building_name: "Victoria House"
        thoroughfare: "High Street"
        post_town: "PORTSMOUTH"
        postcode: "P01 1AF"
    }
    assert paf.format(as_given) fails PostcodeOutsideGb
    var address: UkAddress = attempt paf.format(PafAddress {
        organisation_name: "Cath's Cakes"
        building_name: "Victoria House"
        thoroughfare: "High Street"
        post_town: "PORTSMOUTH"
    })
    assert address.line_1 == "Cath's Cakes"
    assert address.line_2 == "Victoria House"
    assert address.line_3 == "High Street"
    assert address.premise == "Victoria House"
    assert address.number == none
    assert address.postal_address.locality == "PORTSMOUTH"
}

test "Rule 6: Merge sub and building (5): Flat 1, Holly House" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Flat 1"
        building_name: "Holly House"
        building_number: "0"
        thoroughfare: "Oak Avenue"
        dependant_locality: "Biddenden"
        post_town: "ASHFORD"
        postcode: "TN27 8BT"
    })
    assert address.line_1 == "Flat 1, Holly House"
    assert address.line_2 == "Oak Avenue"
    assert address.line_3 == "Biddenden"
    assert address.premise == "Flat 1, Holly House"
    assert address.number == none
    assert address.postal_address.locality == "ASHFORD"
    assert address.postal_address.postal_code == "TN27 8BT"
}

