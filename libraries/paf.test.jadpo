// Royal Mail's examples, as uk-clear-addressing's test/data/formatting.json
// holds them (MIT, Ideal Postcodes), each checked as its
// test/formatting.unit.ts checks it: the three lines, the post town, the
// postcode, the premise and the number. Generated from that file.

test "Rule 7 (1): (Smith)" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "(Smith)"
        building_name: "Rose Cottage"
        thoroughfare: "Packhouse Lane"
        post_town: "BIRMINGHAM"
        postcode: "B39 0DH"
    })
    assert address.line_1 == "(Smith)"
    assert address.line_2 == "Rose Cottage"
    assert address.line_3 == "Packhouse Lane"
    assert address.premise == "(Smith), Rose Cottage"
    assert address.number == none
    assert address.postal_address.locality == "BIRMINGHAM"
    assert address.postal_address.postal_code == "B39 0DH"
}

