// uk-clear-addressing's test/rules.unit.ts (MIT, Ideal Postcodes), each rule's
// cases checked through `paf.format`, which chooses that rule for the record,
// and the accessors case of its test/address.unit.ts. Its rule 7 "sub and
// building merge" case calls rule 7 directly with a building number of `0`,
// which `paf.format` reads as none and takes to rule 6; both give the same
// address. Generated from those files.

test "rule1: returns correct address object" {
    var address: UkAddress = attempt paf.format(PafAddress {
        organisation_name: "Foo Ltd"
        thoroughfare: "High Street"
    })
    assert address.premise == none
    assert address.unit == none
    assert address.number == none
    assert address.line_1 == "Foo Ltd"
    assert address.line_2 == "High Street"
    assert address.line_3 == none
}

test "rule2: returns correct address object" {
    var address: UkAddress = attempt paf.format(PafAddress {
        building_number: "8"
        thoroughfare: "High Street"
    })
    assert address.premise == "8"
    assert address.unit == none
    assert address.number == "8"
    assert address.line_1 == "8 High Street"
    assert address.line_2 == none
    assert address.line_3 == none
}

test "rule3: handles building name exception" {
    var address: UkAddress = attempt paf.format(PafAddress {
        building_name: "8a"
        thoroughfare: "High Street"
    })
    assert address.premise == "8a"
    assert address.unit == none
    assert address.number == "8a"
    assert address.line_1 == "8a High Street"
    assert address.line_2 == none
    assert address.line_3 == none
}

test "rule3: handles sub range match" {
    var address: UkAddress = attempt paf.format(PafAddress {
        building_name: "Foo A"
        thoroughfare: "High Street"
    })
    assert address.premise == "Foo, A"
    assert address.unit == none
    assert address.number == "A"
    assert address.line_1 == "Foo"
    assert address.line_2 == "A High Street"
    assert address.line_3 == none
}

test "rule3: handles sub range match 8-9" {
    var address: UkAddress = attempt paf.format(PafAddress {
        building_name: "Foo 8-9"
        thoroughfare: "High Street"
    })
    assert address.premise == "Foo, 8-9"
    assert address.unit == none
    assert address.number == "8-9"
    assert address.line_1 == "Foo"
    assert address.line_2 == "8-9 High Street"
    assert address.line_3 == none
}

test "rule3: returns correct address object" {
    var address: UkAddress = attempt paf.format(PafAddress {
        building_name: "Foo"
        thoroughfare: "High Street"
    })
    assert address.premise == "Foo"
    assert address.unit == none
    assert address.number == none
    assert address.line_1 == "Foo"
    assert address.line_2 == "High Street"
    assert address.line_3 == none
}

test "rule4: returns correct address object" {
    var address: UkAddress = attempt paf.format(PafAddress {
        building_name: "Foo"
        building_number: "8"
        thoroughfare: "High Street"
    })
    assert address.premise == "Foo, 8"
    assert address.unit == none
    assert address.number == "8"
    assert address.line_1 == "Foo"
    assert address.line_2 == "8 High Street"
    assert address.line_3 == none
}

test "rule5: handles single character sub name" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "a"
        building_number: "8"
        thoroughfare: "High Street"
    })
    assert address.premise == "8a"
    assert address.unit == "a"
    assert address.number == "8"
    assert address.line_1 == "8a High Street"
    assert address.line_2 == none
    assert address.line_3 == none
}

test "rule5: returns correct address format" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Foo"
        building_number: "8"
        thoroughfare: "High Street"
    })
    assert address.premise == "Foo, 8"
    assert address.unit == "Foo"
    assert address.number == "8"
    assert address.line_1 == "Foo"
    assert address.line_2 == "8 High Street"
    assert address.line_3 == none
}

test "rule6: returns correct address object" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Bar"
        building_name: "Foo"
        thoroughfare: "High Street"
    })
    assert address.premise == "Bar, Foo"
    assert address.unit == "Bar"
    assert address.number == none
    assert address.line_1 == "Bar"
    assert address.line_2 == "Foo"
    assert address.line_3 == "High Street"
}

test "rule6: handles name exception in sub building name" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "8a"
        building_name: "Foo"
        thoroughfare: "High Street"
    })
    assert address.premise == "8a Foo"
    assert address.unit == "8a"
    assert address.number == none
    assert address.line_1 == "8a Foo"
    assert address.line_2 == "High Street"
    assert address.line_3 == none
}

test "rule6: handles name exception in building name - 19a" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "1"
        building_name: "Elisa Court 19a"
        thoroughfare: "Flaxfields End"
    })
    assert address.premise == "1, Elisa Court, 19a"
    assert address.unit == "1"
    assert address.number == "19a"
    assert address.line_1 == "1 Elisa Court"
    assert address.line_2 == "19a Flaxfields End"
    assert address.line_3 == none
}

test "rule6: handles name exception in building name" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Bar"
        building_name: "9a"
        thoroughfare: "High Street"
    })
    assert address.premise == "Bar, 9a"
    assert address.unit == "Bar"
    assert address.number == "9a"
    assert address.line_1 == "Bar"
    assert address.line_2 == "9a High Street"
    assert address.line_3 == none
}

test "rule6: handles sub and building merges" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Bar"
        building_name: "Foo"
        building_number: "0"
        thoroughfare: "High Street"
    })
    assert address.premise == "Bar, Foo"
    assert address.unit == "Bar"
    assert address.number == none
    assert address.line_1 == "Bar, Foo"
    assert address.line_2 == "High Street"
    assert address.line_3 == none
}

test "rule7: returns correct address object" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Bar"
        building_name: "Foo"
        building_number: "8"
        thoroughfare: "High Street"
    })
    assert address.premise == "Bar, Foo, 8"
    assert address.unit == "Bar"
    assert address.number == "8"
    assert address.line_1 == "Bar"
    assert address.line_2 == "Foo"
    assert address.line_3 == "8 High Street"
}

test "rule7: handles sub building name exception" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "9a"
        building_name: "Foo"
        building_number: "8"
        thoroughfare: "High Street"
    })
    assert address.premise == "9a Foo, 8"
    assert address.unit == "9a"
    assert address.number == "8"
    assert address.line_1 == "9a Foo"
    assert address.line_2 == "8 High Street"
    assert address.line_3 == none
}

test "rule7: handles sub and building merge" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Bar"
        building_name: "Foo"
