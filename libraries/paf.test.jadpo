test "sort: identical addresses all come back" {
    var elm: PafAddress = PafAddress {
        organisation_name: ""
        department_name: ""
        po_box: ""
        sub_building_name: ""
        building_name: ""
        building_number: "188"
        dependant_thoroughfare: ""
        thoroughfare: "Elm Road"
        double_dependant_locality: ""
        dependant_locality: ""
        post_town: "LEIGH-ON-SEA"
        postcode: "AA1 1AA"
    }
    assert paf.sorted([elm, elm, elm]) == [elm, elm, elm]
}
