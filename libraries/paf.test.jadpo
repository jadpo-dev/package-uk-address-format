}

test "po_box: handles po boxes" {
    var address: UkAddress = attempt paf.format(PafAddress {
        po_box: "8"
        thoroughfare: "High Street"
    })
    assert address.premise == "PO Box 8"
    assert address.unit == none
    assert address.number == none
    assert address.line_1 == "PO Box 8"
    assert address.line_2 == "High Street"
    assert address.line_3 == none
}

test "undocumented rule: handles sub_building_name only" {
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Foo"
        thoroughfare: "High Street"
    })
    assert address.premise == "Foo"
    assert address.unit == "Foo"
    assert address.number == none
    assert address.line_1 == "Foo High Street"
    assert address.line_2 == none
    assert address.line_3 == none
}

test "accessors: give the lines, premise, number and unit" {
    var address: UkAddress = attempt paf.format(PafAddress {
        organisation_name: ""
        department_name: ""
        po_box: ""
        sub_building_name: "Flat 2"
        building_name: "Priory Court"
        building_number: "1"
        dependant_thoroughfare: ""
        thoroughfare: "Kingshill Road"
        double_dependant_locality: ""
        dependant_locality: ""
        post_town: "DURSLEY"
    })
    assert address.premise == "Flat 2, Priory Court, 1"
    assert address.unit == "Flat 2"
    assert address.number == "1"
    assert address.line_1 == "Flat 2"
    assert address.line_2 == "Priory Court"
    assert address.line_3 == "1 Kingshill Road"
}

// uk-clear-addressing's test/sort.integration.ts (MIT, Ideal Postcodes): each
// of its test/data/*.sorted.json streets, in the order it gives, comes back
// in that order from a shuffle. The original shuffles at random on every run;
// here each street is reversed and shuffled three ways, fixed so a run is
// repeatable. Generated from those files.

