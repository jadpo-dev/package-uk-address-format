test "Rule 7 (36): Basement Flat" {
    // BP23 6AA isn't a postcode in Great Britain's form, so the address
    // fails; its lines are checked without it.
    var as_given: PafAddress = PafAddress {
        sub_building_name: "Basement Flat"
        building_name: "Victoria House"
        building_number: "15"
        thoroughfare: "The Street"
        post_town: "CORYTON"
        postcode: "BP23 6AA"
    }
    assert paf.format(as_given) fails PostcodeOutsideGb
    var address: UkAddress = attempt paf.format(PafAddress {
        sub_building_name: "Basement Flat"
        building_name: "Victoria House"
        building_number: "15"
        thoroughfare: "The Street"
        post_town: "CORYTON"
    })
    assert address.line_1 == "Basement Flat"
    assert address.line_2 == "Victoria House"
    assert address.line_3 == "15 The Street"
    assert address.premise == "Basement Flat, Victoria House, 15"
    assert address.number == "15"
    assert address.postal_address.locality == "CORYTON"
}

