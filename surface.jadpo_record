record surface 1

package UkAddressFormat.v1
    /// UK addresses from Royal Mail's Postcode Address File: a record's fragments laid out as Royal Mail's Clear Addressing guidelines say, as address lines, a post town and a postcode, with the premise, number and unit, and sorted as a street's addresses are.
    file package.jadpo
    kind library
    version 1.0.0
    publisher @jadpo
    licence apache_2_0
    jadpo 0.4
    guide GUIDE.md

function paf.format
    /// A record laid out as an address: its lines, its post town in capitals and its postcode, as a `PostalAddress` in Great Britain, with the premise, number and unit on their own. A building name such as `12A` or `1-2` goes before the street, as Royal Mail's Exception Rule says, and a name ending in a range is split.
    file libraries/paf.jadpo
    signature (record: PafAddress) -> UkAddress
    fails PostTownUnreadable
    fails PostcodeOutsideGb

function paf.sorted
    /// The addresses in the order their street numbers them: by building number (or a building or sub-building name the Exception Rule applies to), then building name, sub-building name, organisation, department and PO Box, each compared in its lower case with its runs of digits as numbers, so `2` comes before `10` and `10` before `10A`. Addresses that compare as equal keep their order.
    file libraries/paf.jadpo
    signature (addresses: List<PafAddress>) -> List<PafAddress>

type AddressText = Text
    /// Text laid out from a Postcode Address File record: an address line, a premise, a building number or a unit.
    file types/address_text.jadpo

type PafAddress = Input
    /// A Postcode Address File record's fragments, as Royal Mail's PAF names them (with PAF's own spelling, `dependant`). Every field may be left out.
    file types/paf_address.jadpo
    building_name: PafText? default none
    building_number: PafText? default none
    department_name: PafText? default none
    dependant_locality: PafText? default none
    dependant_thoroughfare: PafText? default none
    double_dependant_locality: PafText? default none
    organisation_name: PafText? default none
    po_box: PafText? default none
    post_town: PafText? default none
    postcode: PostalCode? default none
    sub_building_name: PafText? default none
    thoroughfare: PafText? default none

type PafText = Text
    /// One field of a Postcode Address File record, as the file holds it. A field that is empty or only white space counts as left out.
    file types/paf_text.jadpo

type UkAddress = Object
    /// A Postcode Address File record laid out by Royal Mail's Clear Addressing rules. `line_1` to `line_3` are the premise and street lines, the third holding every line after the second, joined by `, `; the postal address holds those lines, the post town in capitals and the postcode.
    file types/uk_address.jadpo
    line_1: AddressText?
    line_2: AddressText?
    line_3: AddressText?
    number: AddressText?
    postal_address: PostalAddress
    premise: AddressText?
    unit: AddressText?

failure PostTownUnreadable
    /// The record's post town can't be one line of an address: it holds a line break or another control character, or is over 200 characters.
    file failures/post_town_unreadable.jadpo
    kind invalid_value
